# Environment for `docker compose` (copy to .env and fill in). Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Public host name(s), comma separated. localhost/127.0.0.1 are needed for the health check.
DJANGO_ALLOWED_HOSTS=publications.example.org,localhost,127.0.0.1
# Full origin(s) of the site, needed for the Django admin login over HTTPS.
CSRF_TRUSTED_ORIGINS=https://publications.example.org
# HSTS: enable only once HTTPS works for the domain (e.g. 31536000 = 1 year).
DJANGO_HSTS_SECONDS=0
# Production must be served over HTTPS (secure cookies). For a plain-HTTP test
# deployment only, set both of these to false:
# DJANGO_SECURE_COOKIES=false
# AUTH_REFRESH_COOKIE_SECURE=false

# --- Database (PostgreSQL container) ---------------------------------------
DB_NAME=publication_finder
DB_USER=publication_finder
DB_PASSWORD=

# --- External services -------------------------------------------------------
# OpenAlex works without a key; a key/e-mail gives higher rate limits.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# AI insights (optional). Without a key the feature reports "unavailable".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Tuning (optional) -------------------------------------------------------
# Number of trusted proxies in front of Django (nginx = 1; add one per extra load balancer).
NUM_PROXIES=1
WEB_CONCURRENCY=3
HTTP_PORT=80
# THROTTLE_AI=20/day
# THROTTLE_RECOMMENDATIONS=20/hour
# LOG_LEVEL=INFO

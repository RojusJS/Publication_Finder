# Local development settings (copy to Backend/.env). Never commit .env.

DJANGO_DEBUG=true
# Optional in development (a fixed dev key is used when DEBUG is on); required in production.
DJANGO_SECRET_KEY=

# PostgreSQL (recommended). Set DB_ENGINE=sqlite to use a local db.sqlite3 file instead.
DB_ENGINE=postgresql
DB_NAME=publication_finder
DB_USER=publication_finder
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional services
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# REDIS_URL=redis://127.0.0.1:6379/0
# EMBEDDINGS_ENABLED=true
